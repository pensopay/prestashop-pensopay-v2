# Shortcuts for the local PrestaShop shops in docker-compose.yml.
# V selects the version: 81, 82, 90 or 92 (default 81).

V ?= 81
COMPOSE = docker compose --profile ps$(V)

# PrestaShop version whose source the editor indexes (see ide-source).
# The oldest supported version, so autocompletion never suggests APIs 8.1 lacks.
IDE_V ?= 81
IDE_DIR = .prestashop

.PHONY: help up down logs reset shell smoke build ide-source
.DEFAULT_GOAL := help

help: ## List the available targets
	@grep -E '^[a-z-]+:.*## ' $(MAKEFILE_LIST) \
		| awk 'BEGIN { FS = ":.*## " } { printf "  %-12s %s\n", $$1, $$2 }'
	@echo
	@echo "Select the PrestaShop version with V=81, 82, 90 or 92 (default 81)."

up: ## Start the shop (installs it on first start)
	$(COMPOSE) up -d

down: ## Stop the shop, keep its data
	$(COMPOSE) down

logs: ## Follow the shop logs
	$(COMPOSE) logs -f ps$(V)

reset: ## Delete the shop and its database, so the next start is a clean install
	$(COMPOSE) down
	docker volume rm -f pensopay_ps$(V)_html pensopay_ps$(V)_db

shell: ## Open a shell in the shop container
	$(COMPOSE) exec ps$(V) bash

smoke: ## Install and uninstall the module in the shop and check both (same as CI)
	.github/scripts/module-smoke-test.sh ps$(V)

build: ## Build the release zip for the version in pensopay.php (FORCE=1 overwrites without asking)
	bin/build.sh $(if $(filter 1,$(FORCE)),--force) $(VERSION)

ide-source: ## Copy PrestaShop core source into .prestashop/ so the editor knows core classes
	@image=$$(docker compose --profile ps$(IDE_V) config --images | grep '^prestashop/'); \
	echo "Copying PrestaShop source from $$image into $(IDE_DIR)/"; \
	rm -rf $(IDE_DIR) && mkdir -p $(IDE_DIR) && \
	id=$$(docker create $$image) && \
	for dir in classes config controllers src; do \
		docker cp -q $$id:/var/www/html/$$dir $(IDE_DIR)/$$dir || { docker rm $$id >/dev/null; exit 1; }; \
	done; \
	docker rm $$id >/dev/null; \
	echo "$$image" > $(IDE_DIR)/VERSION; \
	{ echo '<?php'; \
	  echo '// PrestaShop declares e.g. PaymentModuleCore and creates PaymentModule at runtime with eval().'; \
	  echo '// These declarations let the editor see the runtime class names. Generated by make ide-source.'; \
	  grep -rhoE '^[[:space:]]*(abstract )?(class|interface) [A-Za-z0-9_]+Core\b' $(IDE_DIR)/classes $(IDE_DIR)/controllers \
	    | sed -E 's/^[[:space:]]*((abstract )?(class|interface)) ([A-Za-z0-9_]+)Core$$/\1 \4 extends \4Core {}/' \
	    | sort -u; \
	} > $(IDE_DIR)/aliases.php; \
	echo "Wrote $$(grep -c extends $(IDE_DIR)/aliases.php) class aliases to $(IDE_DIR)/aliases.php"
