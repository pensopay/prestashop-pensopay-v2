{
  "name": "pensopay/prestashop-pensopay",
  "description": "Pensopay payment module for PrestaShop",
  "type": "prestashop-module",
  "license": "AFL-3.0",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "prestashop/php-dev-tools": "^5.0",
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpunit/phpunit": "^10.5",
    "prestashop/autoindex": "^2.0"
  },
  "autoload": {
    "psr-4": { "PensoPay\\PrestaShop\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "PensoPay\\PrestaShop\\Tests\\": "tests/" }
  },
  "config": {
    "platform": { "php": "8.1" },
    "prepend-autoloader": false,
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "lint": "php-cs-fixer fix --dry-run --diff",
    "lint:fix": "php-cs-fixer fix",
    "stan": [
      "Composer\\Config::disableProcessTimeout",
      "docker run --rm -v \"$PWD\":/var/www/html/modules/pensopay:ro -w /var/www/html/modules/pensopay -e _PS_ROOT_DIR_=/var/www/html --entrypoint php prestashop/prestashop:${PS_VERSION:-8.1} vendor/bin/phpstan analyse --memory-limit=1G"
    ],
    "test": "phpunit"
  },
  "scripts-descriptions": {
    "lint": "Check code style (PHP-CS-Fixer, PrestaShop rules)",
    "lint:fix": "Fix code style",
    "stan": "Run PHPStan inside the prestashop/prestashop Docker image (override version with PS_VERSION)",
    "test": "Run unit tests (PHPUnit)"
  }
}