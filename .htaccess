# Blocks direct requests to the module's PHP files. PrestaShop loads them
# itself, and front controllers are reached through the shop's index.php.
# Images, CSS and JS in views/ stay reachable.

# Apache 2.2
<IfModule !mod_authz_core.c>
    <Files *.php>
        Order allow,deny
        Deny from all
    </Files>
</IfModule>

# Apache 2.4
<IfModule mod_authz_core.c>
    <Files *.php>
        Require all denied
    </Files>
</IfModule>
